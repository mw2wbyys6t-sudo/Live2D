{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@/lib/*": ["lib/*"],
      "@/web/*": ["web/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "lib/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web/node_modules",
    "web/.next",
    "web/out"
  ],
  "references": [
    { "path": "./web/tsconfig.json" }
  ]
}